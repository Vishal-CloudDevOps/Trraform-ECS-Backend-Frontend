{
  "family": "demo-app-frontend-task",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "arn:aws:iam::762687106929:role/ecsTaskExecutionRole",
  "containerDefinitions": [
    {
      "name": "demo-app-frontend",
      "image": "${image}",
      "essential": true,
      "portMappings": [
        { "containerPort": 80, "protocol": "tcp" }
      ],
      "environment": [
        { "name": "ENV_API_URL", "value": "demo-app-alb-1146240332.ap-south-1.elb.amazonaws.com/api" }
      ],
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/demo-frontend",
          "awslogs-region": "ap-south-1",
          "awslogs-stream-prefix": "ecs"
        }
      }
    }
  ]
}
